# --- Letta server ---
LETTA_BASE_URL=https://letta.dmytron.com
LETTA_TOKEN=replace-me
LETTA_TIMEOUT_MS=120000

# --- Logging ---
LOG_LEVEL=info
NODE_ENV=production

# --- Bots ---
# Repeat the BOT_<N>_* block for each bot you want to host.
# N starts at 1 and must be contiguous (1, 2, 3, ...).
BOT_1_NAME=primary
BOT_1_TOKEN=123456:replace-with-telegram-bot-token
BOT_1_AGENT_ID=agent-b4c582f4-e493-4768-a15c-e53b24effc46
# Comma-separated numeric IDs. EMPTY OR UNSET = deny all for that category.
BOT_1_ALLOWED_USER_IDS=
BOT_1_ALLOWED_CHAT_IDS=

# BOT_2_NAME=secondary
# BOT_2_TOKEN=
# BOT_2_AGENT_ID=
# BOT_2_ALLOWED_USER_IDS=
# BOT_2_ALLOWED_CHAT_IDS=
